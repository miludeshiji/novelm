<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NovelM.App\NovelM.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\NovelM.App\Presentation\Publishing\PublishingPage.xaml"
             Link="TestSources\PublishingPage.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\NovelM.App\Presentation\Publishing\PublishingPage.xaml.cs"
             Link="TestSources\PublishingPage.xaml.cs"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
