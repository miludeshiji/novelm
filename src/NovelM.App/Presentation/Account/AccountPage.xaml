<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NovelM_App.Presentation.Account.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel
            MaxWidth="680"
            Margin="24"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="账户" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="登录后可验证个人资料，并在下次启动时恢复会话。"
                TextWrapping="Wrap" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <StackPanel
                Spacing="12"
                Visibility="{x:Bind ViewModel.IsSignedOut, Mode=OneWay}">
                <TextBox
                    Header="邮箱"
                    PlaceholderText="reader@example.com"
                    Text="{x:Bind ViewModel.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <PasswordBox
                    x:Name="PasswordInput"
                    Header="密码"
                    PasswordChanged="PasswordInput_PasswordChanged" />
                <Button
                    Command="{x:Bind ViewModel.LoginCommand}"
                    Content="登录"
                    Style="{ThemeResource AccentButtonStyle}" />
            </StackPanel>

            <Border
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        x:Name="AvatarImage"
                        Width="64"
                        Height="64"
                        VerticalAlignment="Top"
                        Stretch="UniformToFill" />
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.CurrentUser.UserName, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.CurrentUser.RoleName, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.CurrentUser.Id, Mode=OneWay}" />
                        <Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.LogoutCommand}"
                            Content="退出登录" />
                    </StackPanel>
                </Grid>
            </Border>

            <ProgressRing
                Width="28"
                Height="28"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
