<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NovelM_App.Presentation.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:configuration="using:NovelM_App.Domain.Configuration"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel
            MaxWidth="760"
            Margin="24"
            HorizontalAlignment="Left"
            Spacing="16">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="设置" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <TextBlock FontWeight="SemiBold" Text="API 节点" />
            <RadioButtons
                x:Name="ServerOptions"
                ItemsSource="{x:Bind ViewModel.Options}"
                SelectedItem="{x:Bind ViewModel.SelectedServer, Mode=TwoWay}"
                SelectionChanged="ServerOptions_SelectionChanged">
                <RadioButtons.ItemTemplate>
                    <DataTemplate x:DataType="configuration:ApiServerOption">
                        <StackPanel Margin="0,4" Spacing="2">
                            <TextBlock Text="{x:Bind DisplayName}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind BaseUri}" />
                        </StackPanel>
                    </DataTemplate>
                </RadioButtons.ItemTemplate>
            </RadioButtons>

            <ProgressRing
                Width="28"
                Height="28"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <TextBox
                Header="数据目录"
                IsReadOnly="True"
                Text="{x:Bind ViewModel.DataDirectory}" />
        </StackPanel>
    </ScrollViewer>
</Page>
