<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NovelM_App.Presentation.BookProbe.BookProbePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:books="using:NovelM_App.Domain.Books"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Margin="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Header="书籍 ID"
                PlaceholderText="输入大于零的整数"
                Text="{x:Bind ViewModel.BookIdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.LoadBookCommand}"
                Content="获取书籍"
                Style="{ThemeResource AccentButtonStyle}" />
            <ProgressRing
                Grid.Column="2"
                Width="28"
                Height="28"
                VerticalAlignment="Bottom"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <Grid x:Name="ContentGrid" Grid.Row="2" ColumnSpacing="20" RowSpacing="20">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="DetailsColumn.Width" Value="*" />
                            <Setter Target="PreviewColumn.Width" Value="0" />
                            <Setter Target="DetailsRow.Height" Value="*" />
                            <Setter Target="PreviewRow.Height" Value="*" />
                            <Setter Target="PreviewPanel.(Grid.Column)" Value="0" />
                            <Setter Target="PreviewPanel.(Grid.Row)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="DetailsColumn.Width" Value="2*" />
                            <Setter Target="PreviewColumn.Width" Value="3*" />
                            <Setter Target="DetailsRow.Height" Value="*" />
                            <Setter Target="PreviewRow.Height" Value="0" />
                            <Setter Target="PreviewPanel.(Grid.Column)" Value="1" />
                            <Setter Target="PreviewPanel.(Grid.Row)" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DetailsColumn" Width="2*" />
                <ColumnDefinition x:Name="PreviewColumn" Width="3*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="DetailsRow" Height="*" />
                <RowDefinition x:Name="PreviewRow" Height="0" />
            </Grid.RowDefinitions>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            x:Name="CoverImage"
                            Width="104"
                            Height="144"
                            VerticalAlignment="Top"
                            Stretch="UniformToFill" />
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.Book.Title, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.Book.Author, Mode=OneWay}" />
                            <TextBlock
                                MaxLines="5"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Book.Introduction, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <ListView
                        x:Name="ChapterList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Book.Chapters, Mode=OneWay}"
                        SelectionChanged="ChapterList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="books:ChapterSummary">
                                <StackPanel Padding="4" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind SortNum}" />
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border
                x:Name="PreviewPanel"
                Grid.Column="1"
                Padding="20"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.Chapter.Title, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <ScrollViewer Grid.Row="1">
                        <TextBlock
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.Chapter.Content, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
